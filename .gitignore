# Auth & secrets
auths/
data/
*.key
*.pem

# Binaries (anchored to repo root only — bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
/login
/credit
/wb2api
/signin_bin

# Config with secrets (use config.example.json)
config.json

# autoclaw 手机验证码登录 CLI 的构建产物（用 build 脚本重新生成，标的是产物不是源码）
/wb2api-autoclaw-login

# oh-my-Codex 会话/运行态缓存（本地状态，不进版本库）
/.omo/

# Build artifacts
*.tmp
__pycache__/

# 运行日志（service.sh / launchd 输出）
/logs/

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md
docs/

# 设计/计划文档（但 README.md 必须进版本库）
*.md
!README.md
